# Copy to .env and fill in. .env is gitignored.

# ----- Postgres -----
POSTGRES_USER=phish
POSTGRES_PASSWORD=phish
POSTGRES_DB=phish

# ----- Grafana -----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ----- Ingester -----
# Defaults to the in-cluster certstream-server service. Override only if you
# want to point at a public mirror (which may be unreliable).
CERTSTREAM_URL=ws://certstream-server:4000/

# ----- Filter -----
# Lowercase, comma-separated. Order doesn't matter.
BRAND_WATCHLIST=sbi,hdfc,icici,axis,kotak,paytm,phonepe,zerodha,groww

# ----- LLM worker (Groq) -----
# Required. Get from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ----- Dashboard -----
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# ----- General -----
LOG_LEVEL=INFO
